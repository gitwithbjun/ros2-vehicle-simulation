<?xml version="1.0"?>

<robot name="auto_vehicle"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find my_vehicle_description)/urdf/wheel_macro.xacro"/>
  <xacro:include filename="$(find my_sensor_pkg)/urdf/vehicle_sensors.xacro"/>

  <xacro:property name="chassis_length" value="0.60"/>
  <xacro:property name="chassis_width" value="0.30"/>
  <xacro:property name="chassis_height" value="0.12"/>
  <xacro:property name="chassis_mass" value="8.00"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="1.20"/>

  <xacro:property name="wheel_base" value="0.40"/>
  <xacro:property name="wheel_track" value="0.36"/>
  <xacro:property name="max_steer_angle" value="0.52"/>


  <xacro:macro name="box_inertia" params="m x y z">

    <inertial>

      <mass value="${m}"/>

      <origin
          xyz="0 0 ${z / 2.0}"
          rpy="0 0 0"/>

      <inertia
          ixx="${(m / 12.0) * (y*y + z*z)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(m / 12.0) * (x*x + z*z)}"
          iyz="0.0"
          izz="${(m / 12.0) * (x*x + y*y)}"/>

    </inertial>

  </xacro:macro>


  <link name="base_footprint"/>


  <link name="base_link">

    <visual>

      <origin
          xyz="0 0 ${chassis_height / 2.0}"
          rpy="0 0 0"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

      <material name="deep_blue">
        <color rgba="0.1 0.35 0.75 1.0"/>
      </material>

    </visual>


    <collision>

      <origin
          xyz="0 0 ${chassis_height / 2.0}"
          rpy="0 0 0"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

    </collision>


    <xacro:box_inertia
        m="${chassis_mass}"
        x="${chassis_length}"
        y="${chassis_width}"
        z="${chassis_height}"/>

  </link>


  <joint name="base_footprint_joint" type="fixed">

    <parent link="base_footprint"/>

    <child link="base_link"/>

    <origin
        xyz="0 0 ${wheel_radius}"
        rpy="0 0 0"/>

  </joint>


  <xacro:steer_wheel
      prefix="front_left"
      parent="base_link"
      x_reflect="1"
      y_reflect="1"
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"
      wheel_mass="${wheel_mass}"
      wheel_track="${wheel_track}"
      wheel_base="${wheel_base}"
      max_steer_angle="${max_steer_angle}"/>


  <xacro:steer_wheel
      prefix="front_right"
      parent="base_link"
      x_reflect="1"
      y_reflect="-1"
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"
      wheel_mass="${wheel_mass}"
      wheel_track="${wheel_track}"
      wheel_base="${wheel_base}"
      max_steer_angle="${max_steer_angle}"/>


  <xacro:drive_wheel
      prefix="rear_left"
      parent="base_link"
      x_reflect="-1"
      y_reflect="1"
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"
      wheel_mass="${wheel_mass}"
      wheel_track="${wheel_track}"
      wheel_base="${wheel_base}"/>


  <xacro:drive_wheel
      prefix="rear_right"
      parent="base_link"
      x_reflect="-1"
      y_reflect="-1"
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"
      wheel_mass="${wheel_mass}"
      wheel_track="${wheel_track}"
      wheel_base="${wheel_base}"/>


  <gazebo reference="front_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>


  <gazebo reference="front_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>


  <gazebo reference="rear_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>


  <gazebo reference="rear_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>


  <gazebo>

    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

      <left_joint>rear_left_wheel_joint</left_joint>

      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${wheel_track}</wheel_separation>

      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>

      <child_frame_id>base_footprint</child_frame_id>

    </plugin>

  </gazebo>

</robot>